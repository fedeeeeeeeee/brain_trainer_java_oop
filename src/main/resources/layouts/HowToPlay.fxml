<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.web.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity"
	minHeight="-Infinity" minWidth="-Infinity" prefHeight="580.0"
	prefWidth="500.0" xmlns="http://javafx.com/javafx/8"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="view.controllers.HowToPlayFx">
	<children>
		<GridPane VBox.vgrow="SOMETIMES">
			<columnConstraints>
				<ColumnConstraints hgrow="SOMETIMES"
					minWidth="10.0" prefWidth="100.0" />
			</columnConstraints>
			<rowConstraints>
				<RowConstraints vgrow="SOMETIMES" />
				<RowConstraints maxHeight="493.0" minHeight="10.0"
					prefHeight="443.0" vgrow="SOMETIMES" />
				<RowConstraints vgrow="SOMETIMES" />
			</rowConstraints>
			<children>
				<Button fx:id="backBtn" alignment="CENTER"
					contentDisplay="CENTER" mnemonicParsing="false"
					onMouseClicked="#goBack" prefHeight="35.0" prefWidth="65.0"
					text="Back" GridPane.rowIndex="2">
					<font>
						<Font size="18.0" />
					</font>
					<GridPane.margin>
						<Insets bottom="20.0" left="20.0" top="20.0" />
					</GridPane.margin>
				</Button>
				<TextArea fx:id="infoTxt" editable="false"
					prefHeight="452.0" prefWidth="500.0" wrapText="true"
					GridPane.rowIndex="1">
					<font>
						<Font size="16.0" />
					</font>
				</TextArea>
				<Button fx:id="gameInfoBtn" alignment="CENTER"
					contentDisplay="CENTER" mnemonicParsing="false"
					onMouseClicked="#showGameInfo" text="Minigame info"
					GridPane.halignment="RIGHT">
					<font>
						<Font size="18.0" />
					</font>
					<GridPane.margin>
						<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
					</GridPane.margin>
				</Button>
				<Button fx:id="brnTrnInfoBtn" alignment="CENTER"
					contentDisplay="CENTER" mnemonicParsing="false"
					onMouseClicked="#showIntroduction" text="Brain Trainer Info">
					<font>
						<Font size="18.0" />
					</font>
					<GridPane.margin>
						<Insets left="20.0" />
					</GridPane.margin>
				</Button>
			</children>
		</GridPane>
	</children>
</VBox>
