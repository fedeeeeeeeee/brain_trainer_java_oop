<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.web.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="-Infinity" xmlns="http://javafx.com/javafx/8"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="view.controllers.HowToPlayFx">
	<children>
		<GridPane VBox.vgrow="SOMETIMES">
			<columnConstraints>
				<ColumnConstraints hgrow="SOMETIMES"
					minWidth="50.0" />
			</columnConstraints>
			<rowConstraints>
				<RowConstraints maxHeight="79.0" minHeight="39.0"
					prefHeight="79.0" vgrow="SOMETIMES" />
				<RowConstraints vgrow="SOMETIMES" />
				<RowConstraints vgrow="SOMETIMES" />
			</rowConstraints>
			<children>
				<Button fx:id="backBtn" alignment="CENTER"
					contentDisplay="CENTER" mnemonicParsing="false"
					onMouseClicked="#goBack" prefHeight="35.0" prefWidth="65.0"
					text="Back" GridPane.rowIndex="2">
					<font>
						<Font size="18.0" />
					</font>
					<GridPane.margin>
						<Insets bottom="20.0" left="20.0" top="20.0" />
					</GridPane.margin>
				</Button>
				<TextArea fx:id="infoTxt" editable="false"
					prefHeight="452.0" prefWidth="500.0" wrapText="true"
					GridPane.rowIndex="1">
					<font>
						<Font size="16.0" />
					</font>
				</TextArea>
				<GridPane GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
					<columnConstraints>
						<ColumnConstraints hgrow="SOMETIMES" />
						<ColumnConstraints hgrow="SOMETIMES" />
					</columnConstraints>
					<rowConstraints>
						<RowConstraints valignment="CENTER"
							vgrow="SOMETIMES" />
					</rowConstraints>
					<children>
						<Button fx:id="brnTrnInfoBtn" alignment="CENTER"
							contentDisplay="CENTER" mnemonicParsing="false"
							onMouseClicked="#showIntroduction" text="Brain Trainer Info"
							GridPane.halignment="LEFT">
							<font>
								<Font size="18.0" />
							</font>
							<GridPane.margin>
								<Insets left="20.0" />
							</GridPane.margin>
						</Button>
						<Button fx:id="gameInfoBtn" alignment="CENTER"
							contentDisplay="CENTER" mnemonicParsing="false"
							onMouseClicked="#showGameInfo" text="Minigame info"
							GridPane.columnIndex="1" GridPane.halignment="RIGHT">
							<font>
								<Font size="18.0" />
							</font>
							<GridPane.margin>
								<Insets right="20.0" />
							</GridPane.margin>
						</Button>
					</children>
				</GridPane>
			</children>
		</GridPane>
	</children>
</VBox>
