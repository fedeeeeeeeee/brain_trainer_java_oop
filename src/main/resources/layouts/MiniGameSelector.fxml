<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.controllers.MinigameSelectorController">
   <children>
      <Pane onMouseEntered="#initializeCombo" prefHeight="580.0" prefWidth="500.0">
         <children>
            <RadioButton layoutX="217.0" layoutY="176.0" mnemonicParsing="false" text="EASY">
               <font>
                  <Font size="16.0" />
               </font>
            </RadioButton>
            <RadioButton layoutX="217.0" layoutY="256.0" mnemonicParsing="false" text="HARD">
               <font>
                  <Font size="16.0" />
               </font>
            </RadioButton>
            <RadioButton layoutX="217.0" layoutY="216.0" mnemonicParsing="false" text="NORMAL">
               <font>
                  <Font size="16.0" />
               </font>
            </RadioButton>
            <Button layoutX="190.0" layoutY="352.0" mnemonicParsing="false" prefHeight="50.0" prefWidth="120.0" text="PLAY">
               <font>
                  <Font size="17.0" />
               </font>
            </Button>
            <ComboBox fx:id="gameComboBox" editable="true" layoutX="145.0" layoutY="70.0" prefHeight="30.0" prefWidth="210.0" visibleRowCount="5" />
            <Button fx:id="homeBtn" contentDisplay="RIGHT" layoutX="400.0" layoutY="505.0" mnemonicParsing="false" onMouseClicked="#backHome" prefHeight="50.0" prefWidth="70.0" text="Home" />
            <Button fx:id="backBtn" layoutX="30.0" layoutY="505.0" mnemonicParsing="false" onMouseClicked="#backHome" onMousePressed="#goBack" prefHeight="50.0" prefWidth="70.0" text="&lt;" />
         </children>
      </Pane>
   </children>
</AnchorPane>
