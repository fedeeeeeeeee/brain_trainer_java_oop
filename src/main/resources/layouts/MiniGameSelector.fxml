<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.controllers.MinigameSelectorController">
   <children>
      <Pane onMouseEntered="#initializeCombo" prefHeight="500.0" prefWidth="300.0">
         <children>
            <RadioButton layoutX="94.0" layoutY="130.0" mnemonicParsing="false" text="EASY">
               <font>
                  <Font size="16.0" />
               </font>
            </RadioButton>
            <RadioButton layoutX="94.0" layoutY="210.0" mnemonicParsing="false" text="HARD">
               <font>
                  <Font size="16.0" />
               </font>
            </RadioButton>
            <RadioButton layoutX="94.0" layoutY="170.0" mnemonicParsing="false" text="NORMAL">
               <font>
                  <Font size="16.0" />
               </font>
            </RadioButton>
            <Button layoutX="94.0" layoutY="284.0" mnemonicParsing="false" prefHeight="48.0" prefWidth="93.0" text="PLAY">
               <font>
                  <Font size="17.0" />
               </font>
            </Button>
            <ComboBox fx:id="gameComboBox" editable="true" layoutX="75.0" layoutY="69.0" prefWidth="150.0" visibleRowCount="5" />
            <Button fx:id="backBtn" layoutX="30.0" layoutY="435.0" mnemonicParsing="false" onMouseClicked="#goBack" text="&lt;" />
            <Button fx:id="homeBtn" layoutX="212.0" layoutY="435.0" mnemonicParsing="false" onMouseClicked="#backHome" text="Home" />
         </children>
      </Pane>
   </children>
</AnchorPane>
