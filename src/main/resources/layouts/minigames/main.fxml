<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="301.0" prefWidth="325.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.controllers.minigames.ExampleMiniGameControllerFx">

	<children>
		<Button fx:id="btn" alignment="CENTER" onMouseClicked="#btnOnClickHandler" text="Say Hello!" />
		<Label fx:id="scoreLbl" prefHeight="49.0" prefWidth="162.0" text="Label">
			<font>
				<Font size="22.0" />
			</font>
		</Label>
		<Button fx:id="pauseBtn" mnemonicParsing="false" onMouseClicked="#pauseOrRestartTimer" text="pause Or Restart" />
		<Button fx:id="addPoint" mnemonicParsing="false" onMouseClicked="#addPointOnClickHandler" prefHeight="63.0" prefWidth="117.0" text="addPoint" />

		<Label fx:id="timerLbl" alignment="CENTER_LEFT" prefHeight="134.0" prefWidth="246.0" text="Label Text Here!">
			<font>
				<Font size="42.0" />
			</font>
		</Label>
		<ProgressBar fx:id="progressBar" prefWidth="200.0" progress="0.0" />
	</children>
</VBox>
