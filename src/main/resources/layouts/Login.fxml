<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.paint.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.controllers.LoginFxImpl">
	<children>
		<GridPane GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS" VBox.vgrow="ALWAYS">
			<columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" />
				<ColumnConstraints hgrow="SOMETIMES" />
            <ColumnConstraints hgrow="SOMETIMES" />
			</columnConstraints>
			<rowConstraints>
				<RowConstraints vgrow="SOMETIMES" />
				<RowConstraints valignment="CENTER" vgrow="SOMETIMES" />
				<RowConstraints vgrow="SOMETIMES" />
			</rowConstraints>

			<children>
				<Label contentDisplay="TEXT_ONLY" text="Brain Trainer" textOverrun="CENTER_ELLIPSIS" GridPane.columnIndex="1" GridPane.halignment="CENTER">
					<font>
						<Font size="35.0" />
					</font>
				</Label>
				<ImageView fitHeight="217.0" fitWidth="228.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1">
					<image>
						<Image url="@../images/brain_training.png" />
					</image>
					<GridPane.margin>
						<Insets bottom="15.0" />
					</GridPane.margin>
				</ImageView>

			</children>
		</GridPane>
				<GridPane prefHeight="128.0" prefWidth="580.0" VBox.vgrow="ALWAYS">
					<columnConstraints>
						<ColumnConstraints hgrow="ALWAYS" prefWidth="211.0" />
						<ColumnConstraints hgrow="ALWAYS" prefWidth="369.0" />
					</columnConstraints>
					<rowConstraints>
						<RowConstraints vgrow="SOMETIMES" />
						<RowConstraints vgrow="SOMETIMES" />
					</rowConstraints>
					<children>
						<Label nodeOrientation="LEFT_TO_RIGHT" text="Username" GridPane.halignment="RIGHT">
							<font>
								<Font size="18.0" />
							</font>
							<GridPane.margin>
								<Insets right="30.0" />
							</GridPane.margin>
						</Label>
						<PasswordField fx:id="txtPassword" maxWidth="-Infinity" prefHeight="27.0" prefWidth="160.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
						<Label text="Password" GridPane.halignment="RIGHT" GridPane.rowIndex="1">
							<font>
								<Font size="18.0" />
							</font>
							<GridPane.margin>
								<Insets right="30.0" />
							</GridPane.margin>
						</Label>
						<TextField fx:id="txtPlayer" maxWidth="-Infinity" prefHeight="27.0" prefWidth="160.0" GridPane.columnIndex="1" />
					</children>
				</GridPane>
				<GridPane>
					<columnConstraints>
						<ColumnConstraints hgrow="SOMETIMES" />
					</columnConstraints>
					<rowConstraints>
						<RowConstraints vgrow="SOMETIMES" />
					</rowConstraints>
					<children>
						<Label fx:id="errorLbl" contentDisplay="CENTER" textFill="#dd0000" GridPane.halignment="CENTER">
							<font>
								<Font size="15.0" />
							</font>
               <GridPane.margin>
                  <Insets bottom="10.0" top="10.0" />
               </GridPane.margin>
						</Label>
					</children>
				</GridPane>
      <GridPane prefHeight="62.0" prefWidth="580.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" />
            <ColumnConstraints minWidth="-Infinity" />
            <ColumnConstraints minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints minWidth="-Infinity" />
          <ColumnConstraints hgrow="SOMETIMES" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
      						<Button fx:id="signUpBtn" alignment="CENTER" maxHeight="65.0" maxWidth="120.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#signUpPlayer" prefWidth="90.0" text="Sign Up" GridPane.columnIndex="1">
      							<font>
      								<Font size="18.0" />
      							</font>
               <GridPane.margin>
                  <Insets bottom="10.0" />
               </GridPane.margin>
      						</Button>
      						<Button fx:id="loginBtn" maxHeight="65.0" maxWidth="120.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#loginPlayer" prefWidth="90.0" text="Login" GridPane.columnIndex="3">
      							<font>
      								<Font size="18.0" />
      							</font>
               <GridPane.margin>
                  <Insets bottom="10.0" />
               </GridPane.margin>
      						</Button>
         </children>
      </GridPane>
	</children>
</VBox>
