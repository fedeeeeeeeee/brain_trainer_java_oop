<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.paint.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.controllers.LoginFxImpl">
	<children>
		<GridPane fx:id="grid" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS" VBox.vgrow="ALWAYS">
			<columnConstraints>
				<ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" prefWidth="140.0" />
				<ColumnConstraints />
				<ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" prefWidth="140.0" />
			</columnConstraints>
			<rowConstraints>
				<RowConstraints vgrow="SOMETIMES" />
				<RowConstraints vgrow="SOMETIMES" />
				<RowConstraints vgrow="SOMETIMES" />
				<RowConstraints vgrow="SOMETIMES" />
				<RowConstraints vgrow="SOMETIMES" />
			</rowConstraints>

			<children>
				<Label contentDisplay="TEXT_ONLY" text="Brain Trainer" textOverrun="CENTER_ELLIPSIS" GridPane.columnIndex="1" GridPane.halignment="CENTER">
					<font>
						<Font size="35.0" />
					</font>
				</Label>
				<ImageView fitHeight="255.0" fitWidth="277.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1">
					<image>
						<Image url="@../images/brain_training.png" />
					</image>
					<GridPane.margin>
						<Insets bottom="15.0" />
					</GridPane.margin>
				</ImageView>
            <GridPane GridPane.columnIndex="1" GridPane.rowIndex="4">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="133.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="133.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
      						<Button fx:id="signUpBtn" alignment="CENTER" maxHeight="80.0" maxWidth="300.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#signUpPlayer" text="Sign Up">
      							<font>
      								<Font size="18.0" />
      							</font>
      							<GridPane.margin>
      								<Insets bottom="20.0" right="10.0" />
      							</GridPane.margin>
      						</Button>
      						<Button fx:id="loginBtn" maxHeight="80.0" maxWidth="300.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#loginPlayer" text="Login" GridPane.columnIndex="1">
      							<font>
      								<Font size="18.0" />
      							</font>
      							<GridPane.margin>
      								<Insets bottom="20.0" left="10.0" />
      							</GridPane.margin>
      						</Button>
               </children>
            </GridPane>
				<GridPane GridPane.columnIndex="1" GridPane.rowIndex="2">
					<columnConstraints>
						<ColumnConstraints hgrow="ALWAYS" />
						<ColumnConstraints hgrow="ALWAYS" />
					</columnConstraints>
					<rowConstraints>
						<RowConstraints vgrow="SOMETIMES" />
						<RowConstraints vgrow="SOMETIMES" />
					</rowConstraints>
					<children>
						<Label nodeOrientation="LEFT_TO_RIGHT" text="Username" GridPane.halignment="RIGHT" GridPane.hgrow="ALWAYS" GridPane.valignment="CENTER">
							<font>
								<Font size="18.0" />
							</font>
							<GridPane.margin>
								<Insets right="20.0" />
							</GridPane.margin>
						</Label>
						<PasswordField fx:id="txtPassword" maxWidth="-Infinity" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
						<Label text="Password" GridPane.halignment="RIGHT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="CENTER">
							<font>
								<Font size="18.0" />
							</font>
							<GridPane.margin>
								<Insets right="20.0" />
							</GridPane.margin>
						</Label>
						<TextField fx:id="txtPlayer" maxWidth="-Infinity" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.valignment="CENTER" />
					</children>
				</GridPane>
				<Label fx:id="errorLbl" contentDisplay="CENTER" textFill="#dd0000" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="3">
					<font>
						<Font size="15.0" />
					</font>
					<GridPane.margin>
						<Insets bottom="10.0" top="10.0" />
					</GridPane.margin>
				</Label>

			</children>
		</GridPane>
	</children>
</VBox>
