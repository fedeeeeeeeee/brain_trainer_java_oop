<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.effect.*?>
<?import javafx.scene.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="580.0"
	xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="view.controllers.LoginFx">
	<children>
		<GridPane GridPane.halignment="CENTER"
			GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS"
			VBox.vgrow="ALWAYS">
			<columnConstraints>
				<ColumnConstraints hgrow="SOMETIMES"
					minWidth="10.0" prefWidth="100.0" />
			</columnConstraints>
			<rowConstraints>
				<RowConstraints maxHeight="56.0" minHeight="10.0"
					prefHeight="56.0" vgrow="SOMETIMES" />
				<RowConstraints maxHeight="243.0" minHeight="10.0"
					prefHeight="202.0" vgrow="SOMETIMES" />
				<RowConstraints maxHeight="213.0" minHeight="10.0"
					prefHeight="123.0" vgrow="SOMETIMES" />
				<RowConstraints prefHeight="45.0" vgrow="SOMETIMES" />
				<RowConstraints maxHeight="215.0" minHeight="10.0"
					prefHeight="75.0" vgrow="SOMETIMES" />
			</rowConstraints>

			<children>
				<GridPane prefHeight="128.0" prefWidth="580.0"
					GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS"
					GridPane.rowIndex="2" GridPane.vgrow="ALWAYS" VBox.vgrow="ALWAYS">
					<columnConstraints>
						<ColumnConstraints hgrow="ALWAYS"
							prefWidth="211.0" />
						<ColumnConstraints hgrow="ALWAYS"
							prefWidth="369.0" />
					</columnConstraints>
					<rowConstraints>
						<RowConstraints vgrow="SOMETIMES" />
						<RowConstraints vgrow="SOMETIMES" />
					</rowConstraints>
					<children>
						<Label nodeOrientation="LEFT_TO_RIGHT" text="Username"
							GridPane.halignment="RIGHT">
							<font>
								<Font size="18.0" />
							</font>
							<GridPane.margin>
								<Insets right="30.0" />
							</GridPane.margin>
						</Label>
						<PasswordField fx:id="txtPassword"
							maxWidth="-Infinity" prefHeight="27.0" prefWidth="160.0"
							GridPane.columnIndex="1" GridPane.rowIndex="1" />
						<Label text="Password" GridPane.halignment="RIGHT"
							GridPane.rowIndex="1">
							<font>
								<Font size="18.0" />
							</font>
							<GridPane.margin>
								<Insets right="30.0" />
							</GridPane.margin>
						</Label>
						<TextField fx:id="txtPlayer" maxWidth="-Infinity"
							prefHeight="27.0" prefWidth="160.0" GridPane.columnIndex="1" />
					</children>
					<GridPane.margin>
						<Insets />
					</GridPane.margin>
					<padding>
						<Insets bottom="5.0" />
					</padding>
				</GridPane>
				<Label contentDisplay="TEXT_ONLY" prefHeight="20.0"
					prefWidth="186.0" text="Brain Trainer"
					textOverrun="CENTER_ELLIPSIS" GridPane.halignment="CENTER">
					<font>
						<Font size="35.0" />
					</font>
				</Label>
				<ImageView fitHeight="209.0" fitWidth="314.0"
					nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true"
					GridPane.halignment="CENTER" GridPane.rowIndex="1">
					<image>
						<Image url="@../images/brain_training.png" />
					</image>
				</ImageView>
				<GridPane prefHeight="106.0" prefWidth="580.0"
					GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS"
					GridPane.rowIndex="4" GridPane.valignment="CENTER"
					GridPane.vgrow="ALWAYS">
					<columnConstraints>
						<ColumnConstraints hgrow="SOMETIMES" />
						<ColumnConstraints halignment="CENTER"
							hgrow="SOMETIMES" />
					</columnConstraints>
					<rowConstraints>
						<RowConstraints valignment="CENTER" vgrow="ALWAYS" />
					</rowConstraints>
					<children>
						<Button fx:id="signUpBtn" mnemonicParsing="false"
							onMouseClicked="#signUpPlayer" prefWidth="90.0" text="Sign Up"
							GridPane.halignment="RIGHT">
							<GridPane.margin>
								<Insets right="30.0" />
							</GridPane.margin>
							<font>
								<Font size="18.0" />
							</font>
						</Button>
						<Button fx:id="loginBtn" mnemonicParsing="false"
							onMouseClicked="#loginPlayer" prefWidth="90.0" text="Login"
							GridPane.columnIndex="1" GridPane.halignment="LEFT"
							GridPane.valignment="CENTER">
							<font>
								<Font size="18.0" />
							</font>
							<GridPane.margin>
								<Insets left="30.0" />
							</GridPane.margin>
						</Button>
					</children>
				</GridPane>
				<Label fx:id="errorLbl" contentDisplay="CENTER" textFill="RED"
					GridPane.halignment="CENTER" GridPane.rowIndex="3">
					<font>
						<Font size="15.0" />
					</font>
					<GridPane.margin>
						<Insets />
					</GridPane.margin>
				</Label>

			</children>
		</GridPane>
	</children>
</VBox>
