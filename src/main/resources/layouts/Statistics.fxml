						<Font size="18.0" />
					</font>
					<GridPane.margin>
						<Insets bottom="20.0" left="30.0" />
					</GridPane.margin>
				</Button>
            <TabPane fx:id="graphPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE">
