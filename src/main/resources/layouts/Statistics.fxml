                           </children>
                        </AnchorPane>
                  </content>
                </Tab>
                <Tab text="Attention">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <LineChart fx:id="attentionGraph" layoutY="38.0" title="Attention">
                                <xAxis>
                                  <CategoryAxis side="BOTTOM" />
                                </xAxis>
                                <yAxis>
                                  <NumberAxis side="LEFT" />
                                </yAxis>
                              </LineChart>
                              <Label fx:id="bestAttentionLbl" layoutX="368.0" layoutY="14.0" prefHeight="78.0" prefWidth="118.0" />
